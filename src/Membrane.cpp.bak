#include "plugin.hpp"
#include <cmath>
#include <algorithm>

// Membrane — taiko drum: large cylinder with bulged center, patches both ends.
// 8 modes spanning low-mid range, dual sub-octave, click attack.
// Panel 6HP, mono out, 2 voices.

struct Membrane : Module {
	enum ParamIds {
		TUNE_PARAM,
		DECAY_PARAM,
		LEVEL_PARAM,
		MATERIAL_PARAM,
		CHOKE_PARAM,
		NUM_PARAMS
	};
	enum InputIds {
		TRIG_INPUT,
		VOCT_INPUT,
		VELOCITY_INPUT,
		DECAY_CV_INPUT,
		MATERIAL_CV_INPUT,
		PITCH_CV_INPUT,
		NUM_INPUTS
	};
	enum OutputIds {
		OUT_OUTPUT,
		NUM_OUTPUTS
	};
	enum LightIds { NUM_LIGHTS };

	static constexpr int NUM_MODES = 8;
	// Ratios bajos: cubre desde fundamental hasta armónicos medios del cilindro grande
	static constexpr float LEATHER_RATIO[] = {1.00f, 1.25f, 1.75f, 2.50f, 4.00f, 6.50f, 10.00f, 15.00f};
	static constexpr float PLASTIC_RATIO[] = {1.00f, 1.40f, 2.00f, 3.00f, 5.00f, 8.00f, 12.00f, 18.00f};
	// Gain: fundamental fuerte, armónicos medios presentes, agudos cortos
	static constexpr float LEATHER_GAIN[]  = {1.00f, 0.30f, 0.15f, 0.06f, 0.02f, 0.01f, 0.004f, 0.001f};
	static constexpr float PLASTIC_GAIN[]  = {1.00f, 0.40f, 0.22f, 0.10f, 0.04f, 0.015f, 0.006f, 0.002f};
	// Decay: fundamental larga, armónicos cortos
	static constexpr float LEATHER_DECAY[] = {1.00f, 0.85f, 0.70f, 0.55f, 0.40f, 0.28f, 0.18f, 0.10f};
	static constexpr float PLASTIC_DECAY[] = {1.00f, 0.60f, 0.40f, 0.25f, 0.15f, 0.08f, 0.04f, 0.02f};

	struct DrumVoice {
		float envA[NUM_MODES] = {};
		float phaseA[NUM_MODES] = {};
		float subEnv = 0.f;
		float subPhase = 0.f;
		float sub2Env = 0.f;
		float sub2Phase = 0.f;
		float noiseState = 0.f;
		float pitchMul = 2.5f;
		int exciteLeft = 0;
		int samplesSinceTrig = 0;
		uint32_t rng = 33333;

		void trigger(int burst) {
			exciteLeft = burst;
			samplesSinceTrig = 0;
			for (int i = 0; i < NUM_MODES; i++) {
				envA[i] = 1.0f;
				phaseA[i] = 1.5708f;
			}
			subEnv = 3.0f;
			subPhase = 1.5708f;
			sub2Env = 2.0f;
			sub2Phase = 1.5708f;
			noiseState = 0.f;
			pitchMul = 2.5f;
		}

		float noise() {
			rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5;
			return ((float)(rng & 0xFFFFFF) / 16777215.f) * 2.f - 1.f;
		}

		float process(float freq, float baseT60, float sampleRate, float material) {
			samplesSinceTrig++;

			// --- Click de ataque: 12ms ruido brillante ---
			float click = 0.f;
			if (exciteLeft > 0) {
				float raw = noise();
				float hpf = raw - noiseState;
				noiseState = raw * 0.995f + noiseState * 0.005f;
				click = hpf * 2.0f;
				exciteLeft--;
			}

			// Pitch drop continuo: ×2.5 → ×1.0
			float pitchT60 = baseT60 * 0.25f;
			float pitchR = powf(0.001f, 1.f / (pitchT60 * sampleRate));
			pitchMul = 1.0f + (pitchMul - 1.0f) * pitchR;
			if (pitchMul < 1.0f) pitchMul = 1.0f;

			// --- 8 modos con envolvente exponencial ---
			float outMode = 0.f;
			float modeSum = 0.f;

			for (int i = 0; i < NUM_MODES; i++) {
				float ratio = LEATHER_RATIO[i] + (PLASTIC_RATIO[i] - LEATHER_RATIO[i]) * material;
				float gain  = LEATHER_GAIN[i]  + (PLASTIC_GAIN[i]  - LEATHER_GAIN[i])  * material;
				float decay = LEATHER_DECAY[i] + (PLASTIC_DECAY[i] - LEATHER_DECAY[i]) * material;

				float modeT60 = baseT60 * decay * 0.4f;

				float w = 2.f * M_PI * freq * ratio * pitchMul / sampleRate;

				envA[i] *= powf(0.001f, 1.f / (modeT60 * sampleRate));
				if (envA[i] < 1e-6f) envA[i] = 0.f;
				phaseA[i] += w;
				if (phaseA[i] > 6.2831853f) phaseA[i] -= 6.2831853f;
				float y = envA[i] * sinf(phaseA[i]);

				modeSum += gain;
				outMode += y * gain;
			}

			if (modeSum > 0.f) outMode /= modeSum;

			// --- Sub-octava 1 (×0.5): cuerpo grave fuerte ---
			float subFreq = freq * 0.5f;
			float subW = 2.f * M_PI * subFreq / sampleRate;
			float subT60 = 0.04f;
			float subR = powf(0.001f, 1.f / (subT60 * sampleRate));
			subEnv *= subR;
			if (subEnv < 1e-6f) subEnv = 0.f;
			subPhase += subW;
			if (subPhase > 6.2831853f) subPhase -= 6.2831853f;
			float subOut = subEnv * sinf(subPhase);

			// --- Sub-octava 2 (×0.25): sub-bass ---
			float sub2Freq = freq * 0.25f;
			float sub2W = 2.f * M_PI * sub2Freq / sampleRate;
			float sub2T60 = 0.06f;
			float sub2R = powf(0.001f, 1.f / (sub2T60 * sampleRate));
			sub2Env *= sub2R;
			if (sub2Env < 1e-6f) sub2Env = 0.f;
			sub2Phase += sub2W;
			if (sub2Phase > 6.2831853f) sub2Phase -= 6.2831853f;
			float sub2Out = sub2Env * sinf(sub2Phase);

			// --- Mezcla: click 10%, modo 60%, sub1 18%, sub2 12% ---
			float out = click * 0.08f + outMode * 0.55f + subOut * 0.18f + sub2Out * 0.10f;

			// Soft clip muy suave
			out = tanhf(out * 0.5f) * 0.8f;

			// Gate seguridad
			if (samplesSinceTrig > (int)(baseT60 * 4.f * sampleRate)) out = 0.f;

			return out;
		}
	};

	DrumVoice voices[2];
	int lastVoice = 0;
	dsp::SchmittTrigger trig[2];

	Membrane() {
		config(NUM_PARAMS, NUM_INPUTS, NUM_OUTPUTS, NUM_LIGHTS);
		configParam(TUNE_PARAM, -24.f, 24.f, -12.f, "Tune", " semitones");
		configParam(DECAY_PARAM, 0.05f, 4.f, 2.0f, "Decay", " s");
		configParam(LEVEL_PARAM, 0.f, 1.f, 0.75f, "Level");
		configParam(MATERIAL_PARAM, 0.f, 1.f, 0.f, "Material Cuero<>Plastico");
		configParam(CHOKE_PARAM, 0.f, 1.f, 0.f, "Choke");
		configInput(TRIG_INPUT, "Trig");
		configInput(VOCT_INPUT, "V/Oct");
		configInput(VELOCITY_INPUT, "Velocity");
		configInput(DECAY_CV_INPUT, "Decay CV");
		configInput(MATERIAL_CV_INPUT, "Material CV");
		configInput(PITCH_CV_INPUT, "Pitch CV");
		configOutput(OUT_OUTPUT, "Out");
	}

	void process(const ProcessArgs& args) override {
		bool choke = params[CHOKE_PARAM].getValue() > 0.5f;
		float outMix = 0.f;
		int maxChan = 1;
		for (int id : {TRIG_INPUT, VOCT_INPUT, VELOCITY_INPUT}) maxChan = std::max(maxChan, inputs[id].getChannels());
		if (maxChan > 2) maxChan = 2;

		for (int c = 0; c < maxChan; c++) {
			float trigVal = inputs[TRIG_INPUT].getVoltage(c);
			bool doTrig = trig[c].process(rescale(trigVal, 0.01f, 1.f, 0.f, 1.f));
			float voct = inputs[VOCT_INPUT].getVoltage(c) + inputs[PITCH_CV_INPUT].getVoltage(c) * 0.6f;
			float material = clamp(params[MATERIAL_PARAM].getValue() + inputs[MATERIAL_CV_INPUT].getVoltage(c) / 3.f, 0.f, 1.f);
			float baseT60 = clamp(params[DECAY_PARAM].getValue() + inputs[DECAY_CV_INPUT].getVoltage(c) / 3.f, 0.05f, 4.f);
			float tune = params[TUNE_PARAM].getValue();
			// BASE_FREQ = 130 Hz
			float freq = 180.f * powf(2.f, (tune + voct * 12.f) / 12.f);
			freq = clamp(freq, 30.f, args.sampleRate * 0.45f);
			float vel = inputs[VELOCITY_INPUT].isConnected() ? clamp(inputs[VELOCITY_INPUT].getVoltage(c) / 10.f, 0.f, 1.f) : 1.f;
			float level = params[LEVEL_PARAM].getValue() * vel;

			if (doTrig) {
				int v = choke ? (1 - lastVoice) : ((lastVoice + 1) % 2);
				if (choke) {
					voices[1 - v].exciteLeft = 0;
					voices[1 - v].samplesSinceTrig = 99999;
				}
				int burst = std::max(1, (int)(0.012f * args.sampleRate)); // 12ms click
				voices[v].trigger(burst);
				lastVoice = v;
			}
			float voiceOut = 0.f;
			for (int v = 0; v < 2; v++) {
				voiceOut += voices[v].process(freq, baseT60, args.sampleRate, material);
			}
			voiceOut *= level;
			outMix = (c == 0) ? voiceOut : (outMix + voiceOut) * 0.5f;
		}
		outputs[OUT_OUTPUT].setVoltage(clamp(outMix * 100.f, -10.f, 10.f));
		outputs[OUT_OUTPUT].setChannels(1);
	}
};

constexpr float Membrane::LEATHER_RATIO[];
constexpr float Membrane::PLASTIC_RATIO[];
constexpr float Membrane::LEATHER_GAIN[];
constexpr float Membrane::PLASTIC_GAIN[];
constexpr float Membrane::LEATHER_DECAY[];
constexpr float Membrane::PLASTIC_DECAY[];

struct MembraneWidget : ModuleWidget {
	MembraneWidget(Membrane* module) {
		setModule(module);
		setPanel(createPanel(asset::plugin(pluginInstance, "res/Membrane.svg")));
		addParam(createParamCentered<RoundBlackKnob>(mm2px(Vec(8, 22)), module, Membrane::TUNE_PARAM));
		addParam(createParamCentered<RoundBlackKnob>(mm2px(Vec(22, 22)), module, Membrane::DECAY_PARAM));
		addParam(createParamCentered<RoundBlackKnob>(mm2px(Vec(8, 42)), module, Membrane::LEVEL_PARAM));
		addParam(createParamCentered<RoundBlackKnob>(mm2px(Vec(22, 42)), module, Membrane::MATERIAL_PARAM));
		addParam(createParamCentered<CKSS>(mm2px(Vec(15, 58)), module, Membrane::CHOKE_PARAM));
		addInput(createInputCentered<PJ301MPort>(mm2px(Vec(8, 70)), module, Membrane::TRIG_INPUT));
		addInput(createInputCentered<PJ301MPort>(mm2px(Vec(22, 70)), module, Membrane::VOCT_INPUT));
		addInput(createInputCentered<PJ301MPort>(mm2px(Vec(8, 85)), module, Membrane::VELOCITY_INPUT));
		addInput(createInputCentered<PJ301MPort>(mm2px(Vec(22, 85)), module, Membrane::PITCH_CV_INPUT));
		addInput(createInputCentered<PJ301MPort>(mm2px(Vec(8, 100)), module, Membrane::DECAY_CV_INPUT));
		addInput(createInputCentered<PJ301MPort>(mm2px(Vec(22, 100)), module, Membrane::MATERIAL_CV_INPUT));
		addOutput(createOutputCentered<PJ301MPort>(mm2px(Vec(15, 118)), module, Membrane::OUT_OUTPUT));
	}
};

Model* modelMembrane = createModel<Membrane, MembraneWidget>("membrane");